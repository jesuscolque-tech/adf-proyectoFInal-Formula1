{
	"name": "Df_Gold_FactRaceResults",
	"properties": {
		"folder": {
			"name": "Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_Silver_Results",
						"type": "DatasetReference"
					},
					"name": "SourceResults"
				},
				{
					"dataset": {
						"referenceName": "Ds_Silver_Races",
						"type": "DatasetReference"
					},
					"name": "SourceRaces"
				},
				{
					"dataset": {
						"referenceName": "Ds_Gold_DimRace",
						"type": "DatasetReference"
					},
					"name": "SourceDimRace"
				},
				{
					"dataset": {
						"referenceName": "Ds_Gold_DimDate",
						"type": "DatasetReference"
					},
					"name": "SourceDimDate"
				},
				{
					"dataset": {
						"referenceName": "Ds_Gold_DimDriver",
						"type": "DatasetReference"
					},
					"name": "SourceDimDriver"
				},
				{
					"dataset": {
						"referenceName": "Ds_Gold_DimConstructor",
						"type": "DatasetReference"
					},
					"name": "SourceDimConstructor"
				},
				{
					"dataset": {
						"referenceName": "Ds_Gold_DimCircuit",
						"type": "DatasetReference"
					},
					"name": "SourceDimCircuit"
				},
				{
					"dataset": {
						"referenceName": "Ds_Gold_DimStatus",
						"type": "DatasetReference"
					},
					"name": "SourceDimStatus"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ds_Gold_FactRaceResults",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "SeleccionarRaces"
				},
				{
					"name": "LookupRaces"
				},
				{
					"name": "SeleccionarDimRace"
				},
				{
					"name": "LookupDimRace"
				},
				{
					"name": "SeleccionarDimDate"
				},
				{
					"name": "SeleccionarDimDriver"
				},
				{
					"name": "SeleccionarDimConstructor"
				},
				{
					"name": "SeleccionarDimStatus"
				},
				{
					"name": "SeleccionarDimCircuit"
				},
				{
					"name": "LookupDimDate"
				},
				{
					"name": "LookupDimDriver"
				},
				{
					"name": "LookupDimConstructor"
				},
				{
					"name": "LookupDimCircuit"
				},
				{
					"name": "LookupDimStatus"
				},
				{
					"name": "GenerarFactResults"
				},
				{
					"name": "SeleccionarFactResults"
				}
			],
			"scriptLines": [
				"source(output(",
				"          resultId as integer,",
				"          raceId as integer,",
				"          driverId as integer,",
				"          constructorId as integer,",
				"          number as integer,",
				"          grid as integer,",
				"          position as integer,",
				"          positionText as string,",
				"          positionOrder as integer,",
				"          points as decimal(6,2),",
				"          laps as integer,",
				"          time as string,",
				"          milliseconds as long,",
				"          fastestLap as integer,",
				"          rank as integer,",
				"          fastestLapTime as string,",
				"          fastestLapSpeed as decimal(6,3),",
				"          statusId as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceResults",
				"source(output(",
				"          raceId as integer,",
				"          year as integer,",
				"          round as integer,",
				"          circuitId as integer,",
				"          name as string,",
				"          date as date,",
				"          time as string,",
				"          url as string,",
				"          fp1_date as date,",
				"          fp1_time as string,",
				"          fp2_date as date,",
				"          fp2_time as string,",
				"          fp3_date as date,",
				"          fp3_time as string,",
				"          quali_date as date,",
				"          quali_time as string,",
				"          sprint_date as date,",
				"          sprint_time as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceRaces",
				"source(output(",
				"          race_sk as integer,",
				"          race_id as integer,",
				"          season_year as integer,",
				"          round_number as integer,",
				"          race_name as string,",
				"          race_date as date,",
				"          race_time_utc as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceDimRace",
				"source(output(",
				"          date_sk as integer,",
				"          full_date as date,",
				"          year as integer,",
				"          decade as string,",
				"          quarter as integer,",
				"          month as integer,",
				"          month_name as string,",
				"          day_of_week as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceDimDate",
				"source(output(",
				"          driver_sk as integer,",
				"          driver_id as integer,",
				"          driver_ref as string,",
				"          permanent_number as integer,",
				"          driver_code as string,",
				"          forename as string,",
				"          surname as string,",
				"          full_name as string,",
				"          dob as date,",
				"          nationality as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceDimDriver",
				"source(output(",
				"          constructor_sk as integer,",
				"          constructor_id as integer,",
				"          constructor_ref as string,",
				"          constructor_name as string,",
				"          nationality as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceDimConstructor",
				"source(output(",
				"          circuit_sk as integer,",
				"          circuit_id as integer,",
				"          circuit_ref as string,",
				"          circuit_name as string,",
				"          location as string,",
				"          country as string,",
				"          latitude as decimal(9,6),",
				"          longitude as decimal(9,6),",
				"          altitude_m as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceDimCircuit",
				"source(output(",
				"          status_sk as integer,",
				"          status_id as integer,",
				"          status_description as string,",
				"          status_category as string,",
				"          is_finished_flag as boolean",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceDimStatus",
				"SourceRaces select(mapColumn(",
				"          ref_raceId = raceId,",
				"          ref_circuitId = circuitId,",
				"          ref_raceDate = date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarRaces",
				"SourceResults, SeleccionarRaces lookup(raceId == ref_raceId,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupRaces",
				"SourceDimRace select(mapColumn(",
				"          race_sk,",
				"          dim_race_id = race_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarDimRace",
				"LookupRaces, SeleccionarDimRace lookup(raceId == dim_race_id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDimRace",
				"SourceDimDate select(mapColumn(",
				"          date_sk,",
				"          full_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarDimDate",
				"SourceDimDriver select(mapColumn(",
				"          driver_sk,",
				"          dim_driver_id = driver_id,",
				"          dob",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarDimDriver",
				"SourceDimConstructor select(mapColumn(",
				"          constructor_sk,",
				"          dim_constructor_id = constructor_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarDimConstructor",
				"SourceDimStatus select(mapColumn(",
				"          status_sk,",
				"          dim_status_id = status_id,",
				"          is_finished_flag",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarDimStatus",
				"SourceDimCircuit select(mapColumn(",
				"          circuit_sk,",
				"          dim_circuit_id = circuit_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarDimCircuit",
				"LookupDimRace, SeleccionarDimDate lookup(ref_raceDate == full_date,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDimDate",
				"LookupDimDate, SeleccionarDimDriver lookup(driverId == dim_driver_id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDimDriver",
				"LookupDimDriver, SeleccionarDimConstructor lookup(constructorId == dim_constructor_id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDimConstructor",
				"LookupDimConstructor, SeleccionarDimCircuit lookup(ref_circuitId == dim_circuit_id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDimCircuit",
				"LookupDimCircuit, SeleccionarDimStatus lookup(statusId == dim_status_id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LookupDimStatus",
				"LookupDimStatus derive(result_id = resultId,",
				"          grid_position = toInteger(grid),",
				"          final_position = toInteger(position),",
				"          position_order = toInteger(positionOrder),",
				"          laps_completed = toInteger(laps),",
				"          race_time_ms = toLong(milliseconds),",
				"          fastest_lap_speed_kph = toDecimal(fastestLapSpeed,6,3),",
				"          is_win = toInteger(iif(positionOrder == 1, 1, 0)),",
				"          is_podium = toInteger(iif(positionOrder >= 1 && positionOrder <= 3, 1, 0)),",
				"          is_dnf = toInteger(iif(is_finished_flag, 0, 1)),",
				"          positions_gained = iif(grid > 0 && !isNull(position), toInteger(grid - position), toInteger(null())),",
				"          driver_age_at_race = toDecimal(monthsBetween(ref_raceDate, dob) / 12.0, 5, 2),",
				"          fastest_lap_ms = iif(     isNull(fastestLapTime) ||     size(split(fastestLapTime, ':')) != 2,    \r",
				" toInteger(null()),     \r",
				" toInteger(toInteger(split(fastestLapTime, ':')[1]) * 60000  \r",
				" + round(toDouble(split(fastestLapTime, ':')[2]) * 1000, 0)     ) )) ~> GenerarFactResults",
				"GenerarFactResults select(mapColumn(",
				"          resultId,",
				"          race_sk,",
				"          date_sk,",
				"          driver_sk,",
				"          constructor_sk,",
				"          circuit_sk,",
				"          status_sk,",
				"          grid_position,",
				"          final_position,",
				"          position_order,",
				"          points,",
				"          laps_completed,",
				"          race_time_ms,",
				"          fastest_lap_ms,",
				"          fastest_lap_speed_kph,",
				"          is_win,",
				"          is_podium,",
				"          is_dnf,",
				"          positions_gained,",
				"          driver_age_at_race",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarFactResults",
				"SeleccionarFactResults sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          result_sk as long,",
				"          result_id as integer,",
				"          race_sk as integer,",
				"          date_sk as integer,",
				"          driver_sk as integer,",
				"          constructor_sk as integer,",
				"          circuit_sk as integer,",
				"          status_sk as integer,",
				"          grid_position as integer,",
				"          final_position as integer,",
				"          position_order as integer,",
				"          points as decimal(6,2),",
				"          laps_completed as integer,",
				"          race_time_ms as long,",
				"          fastest_lap_ms as integer,",
				"          fastest_lap_speed_kph as decimal(6,3),",
				"          is_win as integer,",
				"          is_podium as integer,",
				"          is_dnf as integer,",
				"          positions_gained as integer,",
				"          driver_age_at_race as decimal(4,1),",
				"          {_loaded_at} as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          result_id = resultId,",
				"          race_sk,",
				"          date_sk,",
				"          driver_sk,",
				"          constructor_sk,",
				"          circuit_sk,",
				"          status_sk,",
				"          grid_position,",
				"          final_position,",
				"          position_order,",
				"          points,",
				"          laps_completed,",
				"          race_time_ms,",
				"          fastest_lap_ms,",
				"          fastest_lap_speed_kph,",
				"          is_win,",
				"          is_podium,",
				"          is_dnf,",
				"          positions_gained,",
				"          driver_age_at_race",
				"     )) ~> sink1"
			]
		}
	}
}