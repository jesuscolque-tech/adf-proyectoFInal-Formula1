{
	"name": "Df_Silver_Results",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_Bronze_Results",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "Ds_Silver_Races",
						"type": "DatasetReference"
					},
					"name": "SourceRaces"
				},
				{
					"dataset": {
						"referenceName": "Ds_Silver_Drivers",
						"type": "DatasetReference"
					},
					"name": "SourceDrivers"
				},
				{
					"dataset": {
						"referenceName": "Ds_Silver_Constructors",
						"type": "DatasetReference"
					},
					"name": "SourceConstructors"
				},
				{
					"dataset": {
						"referenceName": "Ds_Silver_Status",
						"type": "DatasetReference"
					},
					"name": "SourceStatus"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ds_Silver_Results",
						"type": "DatasetReference"
					},
					"name": "SinkResultsValidos"
				},
				{
					"dataset": {
						"referenceName": "Ds_Silver_QuarantineResults",
						"type": "DatasetReference"
					},
					"name": "SinkCuarentena"
				}
			],
			"transformations": [
				{
					"name": "LimpiarResults"
				},
				{
					"name": "EliminarDuplicados"
				},
				{
					"name": "SeleccionarRaceId"
				},
				{
					"name": "ValidarRace"
				},
				{
					"name": "SeleccionarDriverId"
				},
				{
					"name": "ValidarDriver"
				},
				{
					"name": "SeleccionarConstructorId"
				},
				{
					"name": "ValidarConstructor"
				},
				{
					"name": "SeleccionarStatusId"
				},
				{
					"name": "ValidarStatus"
				},
				{
					"name": "ValidarResults"
				},
				{
					"name": "SepararResults"
				},
				{
					"name": "SeleccionarResultsValidos"
				},
				{
					"name": "PrepararCuarentena"
				},
				{
					"name": "SeleccionarCuarentena"
				}
			],
			"scriptLines": [
				"source(output(",
				"          resultId as string,",
				"          raceId as string,",
				"          driverId as string,",
				"          constructorId as string,",
				"          number as string,",
				"          grid as string,",
				"          position as string,",
				"          positionText as string,",
				"          positionOrder as string,",
				"          points as string,",
				"          laps as string,",
				"          time as string,",
				"          milliseconds as string,",
				"          fastestLap as string,",
				"          rank as string,",
				"          fastestLapTime as string,",
				"          fastestLapSpeed as string,",
				"          statusId as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          raceId as integer,",
				"          year as integer,",
				"          round as integer,",
				"          circuitId as integer,",
				"          name as string,",
				"          date as date,",
				"          time as string,",
				"          url as string,",
				"          fp1_date as date,",
				"          fp1_time as string,",
				"          fp2_date as date,",
				"          fp2_time as string,",
				"          fp3_date as date,",
				"          fp3_time as string,",
				"          quali_date as date,",
				"          quali_time as string,",
				"          sprint_date as date,",
				"          sprint_time as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceRaces",
				"source(output(",
				"          driverId as integer,",
				"          driverRef as string,",
				"          number as integer,",
				"          code as string,",
				"          forename as string,",
				"          surname as string,",
				"          dob as date,",
				"          nationality as string,",
				"          url as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceDrivers",
				"source(output(",
				"          constructorId as integer,",
				"          constructorRef as string,",
				"          name as string,",
				"          nationality as string,",
				"          url as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceConstructors",
				"source(output(",
				"          statusId as integer,",
				"          status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceStatus",
				"source1 derive(raw_result_id = resultId,",
				"          raw_race_id = raceId,",
				"          raw_driver_id = driverId,",
				"          raw_constructor_id = constructorId,",
				"          raw_points = points,",
				"          resultId = toInteger(trim(resultId)),",
				"          raceId = toInteger(trim(raceId)),",
				"          driverId = toInteger(trim(driverId)),",
				"          constructorId = toInteger(trim(constructorId)),",
				"          number = toInteger(trim(number)),",
				"          grid = toInteger(trim(grid)),",
				"          position = toInteger(trim(position)),",
				"          positionText = iif(trim(positionText) == '\\\\N' || trim(positionText) == '', toString(null()), trim(positionText)),",
				"          positionOrder = toInteger(trim(positionOrder)),",
				"          points = toDecimal(trim(points), 6, 2),",
				"          laps = toInteger(trim(laps)),",
				"          time = iif(trim(time) == '\\\\N' || trim(time) == '', toString(null()), trim(time)),",
				"          milliseconds = toLong(trim(milliseconds)),",
				"          fastestLap = toInteger(trim(fastestLap)),",
				"          rank = toInteger(trim(rank)),",
				"          fastestLapTime = iif(trim(fastestLapTime) == '\\\\N' || trim(fastestLapTime) == '', toString(null()), trim(fastestLapTime)),",
				"          fastestLapSpeed = toDecimal(trim(fastestLapSpeed), 6, 3),",
				"          statusId = toInteger(trim(statusId))) ~> LimpiarResults",
				"LimpiarResults aggregate(groupBy(resultId,",
				"          raceId,",
				"          driverId,",
				"          constructorId,",
				"          number,",
				"          grid,",
				"          position,",
				"          positionText,",
				"          positionOrder,",
				"          points,",
				"          laps,",
				"          time,",
				"          milliseconds,",
				"          fastestLap,",
				"          rank,",
				"          fastestLapTime,",
				"          fastestLapSpeed,",
				"          statusId,",
				"          raw_result_id,",
				"          raw_race_id,",
				"          raw_driver_id,",
				"          raw_constructor_id,",
				"          raw_points),",
				"     cantidad = count()) ~> EliminarDuplicados",
				"SourceRaces select(mapColumn(",
				"          ref_raceId = raceId",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarRaceId",
				"EliminarDuplicados, SeleccionarRaceId lookup(raceId == ref_raceId,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> ValidarRace",
				"SourceDrivers select(mapColumn(",
				"          ref_driverId = driverId",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarDriverId",
				"ValidarRace, SeleccionarDriverId lookup(driverId == ref_driverId,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> ValidarDriver",
				"SourceConstructors select(mapColumn(",
				"          ref_constructorId = constructorId",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarConstructorId",
				"ValidarDriver, SeleccionarConstructorId lookup(constructorId == ref_constructorId,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> ValidarConstructor",
				"SourceStatus select(mapColumn(",
				"          ref_statusId = statusId",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarStatusId",
				"ValidarConstructor, SeleccionarStatusId lookup(statusId == ref_statusId,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> ValidarStatus",
				"ValidarStatus derive(quarantine_reason = case(     isNull(resultId), 'Invalid resultId',     \r",
				"isNull(raceId), 'Invalid raceId',    \r",
				"isNull(driverId), 'Invalid driverId',    \r",
				"isNull(constructorId), 'Invalid constructorId',    \r",
				"isNull(statusId), 'Invalid statusId',     \r",
				"isNull(points), 'Invalid points',    \r",
				"points < 0, 'Negative points',    \r",
				"isNull(grid), 'Invalid grid',    \r",
				"isNull(positionOrder), 'Invalid positionOrder',   \r",
				"isNull(laps), 'Invalid laps',    \r",
				"isNull(ref_raceId), 'Race not found',   \r",
				"isNull(ref_driverId), 'Driver not found',   \r",
				"isNull(ref_constructorId), 'Constructor not found', \r",
				"isNull(ref_statusId), 'Status not found',     'VALID' )) ~> ValidarResults",
				"ValidarResults split(quarantine_reason == 'VALID',",
				"     disjoint: false) ~> SepararResults@(ResultsValidos, ResultsRechazados)",
				"SepararResults@ResultsValidos select(mapColumn(",
				"          resultId,",
				"          raceId,",
				"          driverId,",
				"          constructorId,",
				"          number,",
				"          grid,",
				"          position,",
				"          positionText,",
				"          positionOrder,",
				"          points,",
				"          laps,",
				"          time,",
				"          milliseconds,",
				"          fastestLap,",
				"          rank,",
				"          fastestLapTime,",
				"          fastestLapSpeed,",
				"          statusId",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarResultsValidos",
				"SepararResults@ResultsRechazados derive({_source_file} = 'results.csv') ~> PrepararCuarentena",
				"PrepararCuarentena select(mapColumn(",
				"          raw_result_id,",
				"          raw_race_id,",
				"          raw_driver_id,",
				"          raw_constructor_id,",
				"          raw_points,",
				"          quarantine_reason,",
				"          {_source_file}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarCuarentena",
				"SeleccionarResultsValidos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          resultId as integer,",
				"          raceId as integer,",
				"          driverId as integer,",
				"          constructorId as integer,",
				"          number as integer,",
				"          grid as integer,",
				"          position as integer,",
				"          positionText as string,",
				"          positionOrder as integer,",
				"          points as decimal(6,2),",
				"          laps as integer,",
				"          time as string,",
				"          milliseconds as long,",
				"          fastestLap as integer,",
				"          rank as integer,",
				"          fastestLapTime as string,",
				"          fastestLapSpeed as decimal(6,3),",
				"          statusId as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          resultId,",
				"          raceId,",
				"          driverId,",
				"          constructorId,",
				"          number,",
				"          grid,",
				"          position,",
				"          positionText,",
				"          positionOrder,",
				"          points,",
				"          laps,",
				"          time,",
				"          milliseconds,",
				"          fastestLap,",
				"          rank,",
				"          fastestLapTime,",
				"          fastestLapSpeed,",
				"          statusId",
				"     )) ~> SinkResultsValidos",
				"SeleccionarCuarentena sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          quarantine_id as long,",
				"          raw_result_id as string,",
				"          raw_race_id as string,",
				"          raw_driver_id as string,",
				"          raw_constructor_id as string,",
				"          raw_points as string,",
				"          quarantine_reason as string,",
				"          {_source_file} as string,",
				"          {_rejected_at} as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          raw_result_id,",
				"          raw_race_id,",
				"          raw_driver_id,",
				"          raw_constructor_id,",
				"          raw_points,",
				"          quarantine_reason,",
				"          {_source_file}",
				"     )) ~> SinkCuarentena"
			]
		}
	}
}